# Copy this file to .env for local development.
# Variables prefixed with VITE_ are bundled into the public frontend code,
# so only put values here that are safe to be public (a form endpoint URL is).
# NEVER put passwords, API secrets or private keys in a VITE_ variable.

# Contact form endpoint. Example with Formspree: https://formspree.io/f/xxxxxxxx
# Leave empty to make the form fall back to opening the visitor's email app (needs `email` in personalInfo.js).
VITE_CONTACT_ENDPOINT=
